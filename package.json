{
  "name": "picoty-zones",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "cd front && npm run dev",
    "dev:server": "cd back && npm run dev",
    "build": "cd front && npm run build",
    "build:preprod": "cd front && npm run build:preprod",
    "start": "cd back && npm start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
